</td></tr><tr>
<td width="56" valign="top" style="padding:0 0 26px 0;font-family:'Archivo',Arial,Helvetica,sans-serif;font-size:40px;line-height:40px;font-weight:200;font-style:italic;color:#B5A36D;">5</td>
